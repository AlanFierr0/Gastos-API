generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CategoryType {
  id         String     @id @default(uuid())
  name       String     @unique
  categories Category[]
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique
  typeId      String
  type        CategoryType @relation(fields: [typeId], references: [id])
  expenses    Expense[]
  income      Income[]
  investments Investment[]
}

model Expense {
  id          String       @id @default(uuid())
  categoryId  String
  amount      Float
  date        DateTime
  note        String?
  createdAt   DateTime     @default(now())
  currency    String       @default("ARS")
  concept     String
  expenseType ExpenseType?
  category    Category     @relation(fields: [categoryId], references: [id])
}

model Income {
  id          String   @id @default(uuid())
  amount      Float
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  currency    String   @default("ARS")
  categoryId  String
  isRecurring Boolean  @default(false)
  concept     String
  category    Category @relation(fields: [categoryId], references: [id])
}

model Investment {
  id             String                @id @default(uuid())
  categoryId     String
  concept        String
  currentAmount  Float
  tag            String?
  originalAmount Float
  date           DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  currentPrice   Float?
  custodyEntity  String?
  category       Category              @relation(fields: [categoryId], references: [id])
  operations     InvestmentOperation[]
}

model InvestmentOperation {
  id           String        @id @default(uuid())
  investmentId String
  type         OperationType
  amount       Float
  price        Float?
  note         String?
  date         DateTime
  createdAt    DateTime      @default(now())
  investment   Investment    @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([createdAt])
  @@index([date])
}

model Price {
  id        String   @id @default(uuid())
  symbol    String   @unique
  type      String
  price     Float
  source    String
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([type])
}

model FinancialAnalysisConfig {
  id              String   @id @default("default")
  fixed           Json     @default("[]")
  wellbeing       Json     @default("[]")
  saving          Json     @default("[]")
  targetFixed     Float    @default(50)
  targetWellbeing Float    @default(30)
  targetSaving    Float    @default(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ExpenseType {
  MENSUAL
  SEMESTRAL
  ANUAL
  EXCEPCIONAL
}

enum OperationType {
  COMPRA
  VENTA
  AJUSTE
}
