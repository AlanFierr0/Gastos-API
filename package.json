{
  "name": "gastos-api",
  "version": "1.0.0",
  "description": "Backend para pagina de gestion de gastos",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "echo \"No tests specified\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-local.js migrate dev",
    "prisma:migrate:reset": "node scripts/prisma-local.js migrate reset",
    "prisma:migrate:init": "node scripts/prisma-local.js migrate dev --name init",
    "prisma:studio": "node scripts/prisma-local.js studio",
    "prisma:studio:prod": "prisma studio",
    "prisma:deploy": "node scripts/prisma-prod.js migrate deploy",
    "prisma:deploy:local": "node scripts/prisma-local.js migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:fix-sync": "node scripts/fix-migration-sync.js",
    "check:unused": "ts-prune",
    "db:verify": "node verify-connection.js",
    "db:verify:local": "cross-env DATABASE_URL=$DATABASE_URL_LOCAL node verify-connection.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:rebuild": "docker-compose down && docker-compose up --build -d",
    "docker:restart": "docker-compose restart",
    "docker:logs": "docker-compose logs -f",
    "docker:update": "docker-compose down && docker-compose up --build -d",
    "check:env": "node check-env.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.0.6",
    "@prisma/client": "^6.18.0",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "pdf-parse": "^2.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3"
  }
}
